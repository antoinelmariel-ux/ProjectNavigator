{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "5ad99227-08ce-4397-bcb1-c45f1a72664e",
  "alias": "ProjectNavigatorWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  "requiresCustomScript": false,
  // SharePointFullPage : page « Application pleine page » ; SharePointWebPart : workbench hébergé.
  "supportedHosts": ["SharePointFullPage", "SharePointWebPart"],
  "supportsFullBleed": true,
  "supportsThemeVariants": false,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Project Navigator", "fr-FR": "Project Navigator" },
    "description": {
      "default": "Project Navigator - regulatory risk qualification",
      "fr-FR": "Project Navigator - qualification des enjeux réglementaires"
    },
    "officeFabricIconFontName": "Compass",
    "properties": {}
  }]
}
